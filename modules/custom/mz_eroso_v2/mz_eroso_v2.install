/**
 * Removes legacy values from field_status_commande and remaps existing nodes.
 */
function mz_eroso_v2_update_10009() {
  $module_path = \Drupal::service('extension.list.module')->getPath('mz_eroso_v2');
  $storage = new FileStorage($module_path . '/config/install');
  $name = 'field.storage.node.field_status_commande';
  if ($storage->exists($name)) {
    \Drupal::configFactory()->getEditable($name)->setData($storage->read($name))->save(TRUE);
  }

  $legacy = ['transfer_vers_boutique', 'en_livraison', 'payer_recue'];
  $nids = \Drupal::entityQuery('node')
    ->condition('type', 'order_commande')
    ->condition('field_status_commande.value', $legacy, 'IN')
    ->accessCheck(FALSE)
    ->execute();

  foreach ($nids as $nid) {
    $node = Node::load($nid);
    if ($node && $node->hasField('field_status_commande')) {
      $node->set('field_status_commande', 'recue_a_mada');
      $node->save();
    }
  }

  drupal_flush_all_caches();
  return t('field_status_commande legacy values removed and remapped to recue_a_mada.');
}

