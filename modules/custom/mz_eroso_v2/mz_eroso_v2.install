<?php

/**
 * @file
 * Install and update hooks for mz_eroso_v2.
 */

use Drupal\Core\Config\FileStorage;
use Drupal\Core\Database\Database;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\Node;

/**
 * Imports the product_commande content type (clone of product).
 */
function mz_eroso_v2_update_10001() {
  $module_path = \Drupal::service('extension.list.module')->getPath('mz_eroso_v2');
  $storage = new FileStorage($module_path . '/config/install');
  $configs = [
    'node.type.product_commande',
    'core.base_field_override.node.product_commande.title',
    'field.field.node.product_commande.field_category',
    'field.field.node.product_commande.field_description',
    'field.field.node.product_commande.field_image',
    'field.field.node.product_commande.field_images',
    'field.field.node.product_commande.field_media_image',
    'field.field.node.product_commande.field_price',
    'field.field.node.product_commande.field_prix_vente',
    'field.field.node.product_commande.field_produits_attribute',
    'field.field.node.product_commande.field_quantite_disponible',
    'field.field.node.product_commande.field_sku',
    'field.field.node.product_commande.field_status',
    'core.entity_form_display.node.product_commande.default',
    'core.entity_view_display.node.product_commande.default',
    'core.entity_view_display.node.product_commande.teaser',
  ];
  $factory = \Drupal::configFactory();
  foreach ($configs as $name) {
    if ($factory->get($name)->isNew() && $storage->exists($name)) {
      $factory->getEditable($name)->setData($storage->read($name))->save(TRUE);
    }
  }
  drupal_flush_all_caches();
  return t('Content type product_commande (clone of product) has been installed.');
}

