/**
 * Adds field_client (entity reference to client) on order_commande.
 */
function mz_eroso_v2_update_10005() {
  $module_path = \Drupal::service('extension.list.module')->getPath('mz_eroso_v2');
  $storage = new FileStorage($module_path . '/config/install');
  $configs = [
    'field.storage.node.field_client',
    'field.field.node.order_commande.field_client',
    'core.entity_form_display.node.order_commande.default',
    'core.entity_view_display.node.order_commande.default',
    'core.entity_view_display.node.order_commande.teaser',
  ];
  $factory = \Drupal::configFactory();
  foreach ($configs as $name) {
    if ($storage->exists($name)) {
      $factory->getEditable($name)->setData($storage->read($name))->save(TRUE);
    }
  }

  $field_storage = FieldStorageConfig::loadByName('node', 'field_client');
  if ($field_storage) {
    $schema = Database::getConnection()->schema();
    if (!$schema->tableExists('node__field_client')) {
      \Drupal::service('field_storage_definition.listener')->onFieldStorageDefinitionCreate($field_storage);
    }
  }

  drupal_flush_all_caches();
  return t('Field field_client added to order_commande.');
}

/**
 * Replaces field_status_local on order_commande with field_status_commande (list).
 */
function mz_eroso_v2_update_10006() {
  $module_path = \Drupal::service('extension.list.module')->getPath('mz_eroso_v2');
  $file_storage = new FileStorage($module_path . '/config/install');
  $configs = [
    'field.storage.node.field_status_commande',
    'field.field.node.order_commande.field_status_commande',
    'core.entity_form_display.node.order_commande.default',
    'core.entity_view_display.node.order_commande.default',
    'core.entity_view_display.node.order_commande.teaser',
  ];
  $factory = \Drupal::configFactory();
  foreach ($configs as $name) {
    if ($file_storage->exists($name)) {
      $factory->getEditable($name)->setData($file_storage->read($name))->save(TRUE);
    }
  }

  $field_storage = FieldStorageConfig::loadByName('node', 'field_status_commande');
  if ($field_storage) {
    $schema = Database::getConnection()->schema();
    if (!$schema->tableExists('node__field_status_commande')) {
      \Drupal::service('field_storage_definition.listener')->onFieldStorageDefinitionCreate($field_storage);
    }
  }

  $old_field = FieldConfig::loadByName('node', 'order_commande', 'field_status_local');
  if ($old_field) {
    $nids = \Drupal::entityQuery('node')
      ->condition('type', 'order_commande')
      ->accessCheck(FALSE)
      ->execute();
    foreach ($nids as $nid) {
      $node = Node::load($nid);
      if (!$node || !$node->hasField('field_status_local') || $node->get('field_status_local')->isEmpty()) {
        continue;
      }
      $old = $node->get('field_status_local')->value;
      $map = [
        'payer' => 'payer_recue',
        'annuler' => 'annuler',
      ];
      $new = $map[$old] ?? 'payer_recue';
      if ($node->hasField('field_status_commande')) {
        $node->set('field_status_commande', $new);
        $node->save();
      }
    }
    $old_field->delete();
  }

  drupal_flush_all_caches();
  return t('order_commande: field_status_local replaced by field_status_commande.');
}

