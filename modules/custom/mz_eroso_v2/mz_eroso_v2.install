/**
 * Ensures SQL tables/columns exist for field_taobao_url (config import skips schema).
 */
function mz_eroso_v2_update_10003() {
  $connection = Database::getConnection();
  $schema = $connection->schema();
  $tables = [
    'node__field_taobao_url',
    'node_revision__field_taobao_url',
  ];
  $main = 'node__field_taobao_url';
  $needs_schema = !$schema->tableExists($main)
    || !$schema->fieldExists($main, 'field_taobao_url_uri');

  if ($needs_schema) {
    foreach ($tables as $table) {
      if ($schema->tableExists($table)) {
        $schema->dropTable($table);
      }
    }
    $field_storage = FieldStorageConfig::loadByName('node', 'field_taobao_url');
    if ($field_storage) {
      \Drupal::service('field_storage_definition.listener')->onFieldStorageDefinitionCreate($field_storage);
    }
  }

  drupal_flush_all_caches();
  return t('field_taobao_url database schema has been ensured.');
}

