<?php

/**
 * @file
 * Install and update hooks for mz_claude_api.
 */

use Drupal\Core\Config\FileStorage;
use Drupal\Core\Database\Database;
use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\field\Entity\FieldStorageConfig;

/**
 * Adds field_search_image (textarea) to product content type.
 */
function mz_claude_api_update_9001() {
  $module_path = \Drupal::service('extension.list.module')->getPath('mz_claude_api');
  $storage = new FileStorage($module_path . '/config/install');
  $configs = [
    'field.storage.node.field_search_image',
    'field.field.node.product.field_search_image',
  ];
  $factory = \Drupal::configFactory();
  foreach ($configs as $name) {
    if ($storage->exists($name)) {
      $factory->getEditable($name)->setData($storage->read($name))->save(TRUE);
    }
  }

  $field_storage = FieldStorageConfig::loadByName('node', 'field_search_image');
  if ($field_storage) {
    $schema = Database::getConnection()->schema();
    if (!$schema->tableExists('node__field_search_image')) {
      \Drupal::service('field_storage_definition.listener')->onFieldStorageDefinitionCreate($field_storage);
    }
  }

  $form_display = EntityFormDisplay::load('node.product.default');
  if ($form_display && !$form_display->getComponent('field_search_image')) {
    $form_display->setComponent('field_search_image', [
      'type' => 'text_textarea',
      'weight' => 1,
      'region' => 'content',
      'settings' => [
        'rows' => 5,
        'placeholder' => '',
      ],
    ])->save();
  }

  foreach (['default', 'teaser'] as $mode) {
    $view_display = EntityViewDisplay::load('node.product.' . $mode);
    if ($view_display && !$view_display->getComponent('field_search_image')) {
      $view_display->setComponent('field_search_image', [
        'type' => 'text_default',
        'weight' => 20,
        'region' => 'content',
        'label' => 'above',
        'settings' => [],
      ])->save();
    }
  }

  drupal_flush_all_caches();
  return t('Field field_search_image added to product.');
}

/**
 * Ensures field_search_image_value uses LONGTEXT (prod may have VARCHAR/TEXT).
 */
function mz_claude_api_update_9002() {
  $connection = Database::getConnection();
  $schema = $connection->schema();
  $spec = [
    'type' => 'text',
    'size' => 'big',
    'not null' => TRUE,
  ];
  $tables = [
    'node__field_search_image',
    'node_revision__field_search_image',
  ];
  foreach ($tables as $table) {
    if (!$schema->tableExists($table) || !$schema->fieldExists($table, 'field_search_image_value')) {
      continue;
    }
    $schema->changeField($table, 'field_search_image_value', 'field_search_image_value', $spec);
    if (!$schema->fieldExists($table, 'field_search_image_format')) {
      $schema->addField($table, 'field_search_image_format', [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ]);
    }
  }
  drupal_flush_all_caches();
  return t('field_search_image_value column set to LONGTEXT.');
}

/**
 * Adds field_search_image to product_commande content type.
 */
function mz_claude_api_update_9003() {
  $module_path = \Drupal::service('extension.list.module')->getPath('mz_claude_api');
  $storage = new FileStorage($module_path . '/config/install');
  $name = 'field.field.node.product_commande.field_search_image';
  $factory = \Drupal::configFactory();
  if ($storage->exists($name)) {
    $factory->getEditable($name)->setData($storage->read($name))->save(TRUE);
  }

  $form_display = EntityFormDisplay::load('node.product_commande.default');
  if ($form_display && !$form_display->getComponent('field_search_image')) {
    $form_display->setComponent('field_search_image', [
      'type' => 'text_textarea',
      'weight' => 30,
      'region' => 'content',
      'settings' => [
        'rows' => 5,
        'placeholder' => '',
      ],
    ])->save();
  }

  $view_display = EntityViewDisplay::load('node.product_commande.default');
  if ($view_display && !$view_display->getComponent('field_search_image')) {
    $view_display->setComponent('field_search_image', [
      'type' => 'text_default',
      'weight' => 20,
      'region' => 'content',
      'label' => 'hidden',
      'settings' => [],
    ])->save();
  }

  drupal_flush_all_caches();
  return t('Field field_search_image added to product_commande.');
}

/**
 * Migre le modèle Claude vers Gemini dans la config active.
 */
function mz_claude_api_update_9004() {
  $config = \Drupal::configFactory()->getEditable('mz_claude_api.settings');
  $model = trim((string) $config->get('model'));
  if ($model === '' || str_starts_with($model, 'claude-') || str_starts_with($model, 'anthropic/')) {
    $config->set('model', 'gemini-3.6-flash')->save();
    return t('Modèle IA mis à jour : gemini-3.6-flash.');
  }
  return t('Modèle IA déjà configuré : @model.', ['@model' => $model]);
}
