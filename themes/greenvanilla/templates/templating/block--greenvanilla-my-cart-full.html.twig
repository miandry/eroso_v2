
<style>
 .price_total{
    font-size: 35px;
    font-weight: bold;
 }
.label_total{
    font-size: 35px !important;
    font-weight: 200 !important;
 }
 
 @media (max-width: 767.98px) {
    .tb-cart .row {
        height: auto;
    }
    
    .coupon .btn {
        margin-left: auto;
    }
}
</style>
<!-- ***** Main Banner Area Start ***** -->
<div class="swiper-container-not cart" id="top">
  <div class="swiper-wrapper">
    <div class="swiper-slide">
      <div class="">
        <div class="container">
          <div class="row">
            <div class="col-lg-8 mx-auto">
              <div class="header-text">
                <h1>My cart</h1>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- ***** Main Banner Area End ***** -->
{% if is_login() %}
{% set carts = list_carts(100) %}
{% set total_amount = 0 %}

    <div class="main-container ">
        <div class="container col-main panier">
        {% if carts is not empty %}
          <div class="row">
              <!-- Main Column -->
              <div class="tb-cart" id="carstList">
                <div class="row tb-titre">
                    <div class="col-md-1"><span class="d-none">Check box</span></div>
                    <div class="col-md-2"><span class="d-none">Product Image</span></div>
                    <div class="col-md-3">Product</div>
                    <div class="col-md-2">Price</div>
                    <div class="col-md-1">Quantity</div>
                    <div class="col-md-2">Subtotal</div>
                    <div class="col-md-1"><span class="d-none">Delete</span></div>
                </div>
                  {% for key,item in carts %}
                  
                    <div class="row tb-val">    
                        <div class="col-md-1"><input type="checkbox" class="check-cart" data-price="{{item.price}}"  value="{{item.nid}}" /> </div>  
                        <div class="col-md-2 p-img"><img src="{{item.image.url}}" class="fluid"></div>
                        <div class="col-md-3"><label class="d-md-none">Product: </label>{{item.product_name}}</div>
                        <div class="col-md-2"><label class="d-md-none">Price: </label><span class="price">${{ price ( item.price ) }}</span></div>
                        <div class="col-md-1"><label class="d-md-none">Quantity: </label><input type="number" class="quantity-input" id="quantity" name="quantity" value="{{item.quantity}}"></div>
                        <div class="col-md-2"><label class="d-md-none">Subtotal: </label><span class="total-price">$ {{ price (item.total) }}</span></div>
                        <div class="col-md-1 del">
                        	<a data-delete-url="/confirm-delete/{{item.nid}}" 
                          data-action="delete"
                          class="a-del" 
                          href="#">
                          <i class="bi bi-x"></i>
                        </a>
                        
                        </div>   
                    </div>
                    {% set total_amount = total_amount + item.total %}
                  {% endfor %}
                <div class="row tb-foot">
                    <div class="col-md-6">
                       <div class="coupon d-sm-flex">
                            <button data-action="update-carts"  data-carts="carstList" class="btn btn-jaune">Update Carts</button>
                            <button  data-action="checkout"  data-carts="carstList"  class="btn btn-success">Proceed to Checkout</button>
                        </div>
                    </div>
                    <div class="col-md-6 btn-update">
                           <div class="col-xs-6"><label class="label_total">Total</label></div>
                           <div class="col-xs-6">
                                <div class="col-xs-10 text-center"><span class="price price_total">${{price(total_amount)}}</span></div>
                                <div class="col-xs-2"></div>
                           </div>
                    </div>
                </div>
              </div>         
          </div>
        {% else %}
            <div class="row justify-content-center">
                <div class="col-12 col-md-8 text-center">
                    <p class="h3">
                        Your cart is currently empty
                    </p>
                    <p class="mt-4">
                        <a href="{{ base_url() }}/shop" class="px-2 py-2 fond-jaune text-white fw-bold text-decoration-none rounded">visit our shops</a>
                    </p>
                </div>
            </div>
        {% endif %}
          
        </div>
    </div> 
{% else %}
    <div class="row justify-content-center mt-5">
        <div class="col-12 col-md-8 text-center">
            <p>
                To view your cart, you must log in.
            </p>
            <div class="my-5">
                <a class="btn text-white fond-jaune" href="{{base_url()}}/connexion">
                    Login
                </a>
                <a class="btn text-white fond-green" href="{{base_url()}}/inscription">
                    Register
                </a>
            </div>
        </div>
    </div>
{% endif %}