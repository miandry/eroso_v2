{% set c = block_parser(content) %}
{% if not is_login() %}
<div class="main-container d-flex align-items-center justify-content-center">
	<div class="col-sm-6 box-register">
		<h4 class="box-title">Registration</h4>
		<div class="box-form auth-user">
		    {{ user_register() }}
			<div class="link-ins-con">
    		    <a href="/connexion"> Se connecter </a>
    		</div>
		</div>
	</div>
</div>
{% else %} 
    {% set url = '' ~ base_url() ~ '/user' %}
    {{ redirect(url) }}
{% endif %}