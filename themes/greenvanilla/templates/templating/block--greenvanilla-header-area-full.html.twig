{% set c = block_parser(content) %}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.min.css" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.2/jquery.min.js" integrity="sha512-tWHlutFnuG0C6nQRlpvrEhE4QpkG1nn2MOUMWmUeRePl4e3Aki0VB6W1v3oLjFtd0hVOtRQ9PHpSfN6u6/QXkQ=="
crossorigin="anonymous" referrerpolicy="no-referrer"></script>
{% set menus = simplify_menu(c.field_menu) %}
{% if is_login() %}
    {% set user = current_user() %}
    {% set myCart = {
            'type':'cart',
            'status': 1,
            'uid': user['uid']
        }
    %}
{#{% set myCartCount = node_parser_by_properties(myCart)|length %}#}

{% endif %}
<header class="header-area header-sticky">
  <div class="container pt-2">
      <div class="row">
          <div class="col-12">
              <nav class="main-nav">
                  <!-- ***** Logo Start ***** -->
                 <div class="col-4" style="user-select:none;"> 
                      <a href="/" class="logo">
                          <img src="{{ c.field_logo.url }}" alt="{{ c.field_logo.alt }}" class="img-fluid"> 
                      </a>
                </div>
                  <!-- ***** Logo End ***** -->
                  <div class="col-8">   
                  <!-- ***** Menu Start ***** -->
                  <ul class="nav ms-0">
                      {% for menu_item in menus.menu_tree %}
                        {% set active = (menu_item.active) ? 'active' : '' %}
                        {% set active = (menu_item.active_trail or active) ? 'active' : '' %}
                        <li class="scroll-to-section {{ menu_item.submenu?'position-relative gv-nav-drop':'' }} ">
                          <a href="{{ menu_item.submenu?'#':menu_item.url }}" class=" {{ active }} "> {{ menu_item.text }} </a>
                          {% if menu_item.submenu %}
                          <ul class="dr-profile bg-white position-absolute" style="min-width: 150px;">
                            {% for submenu_item in menu_item.submenu %}
                            {% set subactive = (submenu_item.active) ? 'active' : '' %}
                            {% set subactive = (submenu_item.active_trail or active) ? 'active' : '' %}
                            <li class="p-0">
                              <a class="text-black p-3 py-2 gv-fs-6 fw-normal {{ subactive }} " href="{{ submenu_item.url }}">
                                {{ submenu_item.text }}
                              </a>
                            </li>
                            {% endfor %}
                          </ul>
                          {% endif %}
                          
                        </li>
                      {% endfor %}
                  </ul>
                  <ul class="nav btn-icons ms-0">
                  <li class="nav-search d-none d-md-block">
                    <button class="btn" id="searchButton">
                      <i class="bi bi-search"></i>
                    </button>
                    <form id="searchForm" class="mt-3" action="/en/shop" method="get">
                        <div class="row justify-content-between g-0">
                          <div class="form-group m-0 col">
                            <input type="text" class="form-control m-0" id="searchInput" name="keys" placeholder="Search product">
                          </div>
                          <button type="submit" class="btn"><i class="bi bi-search"></i></button>
                        </div>
                    </form>
                  </li>
                  <li class="nav-cart d-md-block d-none">
                      	<!--carts NUMBER :	{{	count_carts()}} -->
                    <a class="btn py-2 position-relative" id="cartButton" href="{{ base_url() }}/my-cart">
                      <i class="bi bi-cart"></i>
                        {% if is_login() %}
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning">{{count_carts()}}</span>
                        {% endif %}
                    </a>
                  </li>
                  <li class="nav-cart d-block d-md-none">
                      	<!--carts NUMBER :	{{	count_carts()}} -->
                    <a class="btn py-2" href="{{ base_url() }}/my-cart">
                      <i class="bi bi-cart"></i>
                        {% if is_login() %}
                            <span class="badge rounded-pill bg-warning">{{count_carts()}}</span>
                        {% endif %}
                    </a>
                  </li>
                </ul>         
                <a class="menu-trigger test-try">
                      <span>Menu</span>
                </a>
              </div>
                  <!-- ***** Menu End ***** -->
              </nav>
          </div>
      </div>
  </div>
</header>

<script>
    document.getElementById('searchButton').addEventListener('click', function() {
        var form = document.getElementById('searchForm');
        if (form.style.display === 'none' || form.style.display === '') {
          form.style.display = 'block';
        } else {
          form.style.display = 'none';
        }
    });
    $(".menu-trigger").on('click', function() {	
		$(this).toggleClass('active');
		$('.header-area .nav').slideToggle(200);
	});
</script>
